@techreport{ACEL2005WP,
   author = {David Altig and Lawrence J. Christiano and Martin Eichenbaum and Jesper Lindé},
   title = {Firm-Specific Capital, Nominal Rigidities and the Business Cycle},
   institution = {National Bureau of Economic Research},
   type = {NBER Working Paper},
   number = {11034},
   year = {2005},
   month = {1},
   note = {Working paper predecessor of the published version (Review of Economic Dynamics, 2011)},
   abstract = {This paper formulates and estimates a three-shock U.S. business cycle model. The estimated model accounts for a substantial fraction of the cyclical variation in output and is consistent with the observed inertia in inflation. This is true even though firms in the model re-optimize prices on average once every 1.8 quarters. The key feature of our model underlying this result is that capital is firm-specific.}
}

@article{ACEL2011,
   author = {David Altig and Lawrence J. Christiano and Martin Eichenbaum and Jesper Lindé},
   title = {Firm-Specific Capital, Nominal Rigidities and the Business Cycle},
   journal = {Review of Economic Dynamics},
   year = {2011},
   volume = {14},
   number = {2},
   pages = {225-247},
   doi = {10.1016/j.red.2010.01.001},
   abstract = {This paper formulates and estimates a three-shock U.S. business cycle model. The estimated model accounts for a substantial fraction of the cyclical variation in output and is consistent with the observed inertia in inflation. This is true even though firms in the model re-optimize prices on average once every 1.8 quarters. The key feature of our model underlying this result is that capital is firm-specific.}
}

@article{Antolin-Diaz_Surico2025,
   author = {Juan Antolín-Díaz and Paolo Surico},
   title = {The Long-Run Effects of Government Spending},
   journal = {American Economic Review},
   year = {2025},
   volume = {115},
   number = {7},
   pages = {2376-2413},
   doi = {10.1257/aer.20231278},
   abstract = {Military spending has large and persistent effects on output because it shifts the composition of public spending toward R\&D. This boosts innovation and private investment in the medium term and increases productivity and GDP at longer horizons. Public R\&D expenditure stimulates economic activities beyond the business cycle even when it is not associated with war spending.}
}

@unpublished{AntolinDiaz_FernandezVillaverde_GuerronQuintana2026,
   author = {Juan Antolín-Díaz and Jesús Fernández-Villaverde and Pablo Guerrón-Quintana},
   title = {Double Descent in Time Series},
   note = {Work in progress. Presented in slides; no draft circulated at the time of writing},
   year = {2026},
   abstract = {The paper studies whether the "double descent" phenomenon documented in the machine learning literature -- a second decline in test error as model complexity grows well beyond the sample size, beyond the classical U-shaped bias-variance trade-off -- also arises in time series settings relevant to macroeconometrics, including in the solution of DSGE models.}
}

@techreport{Aruoba_Drechsel2024_MP_LLM,
   author = {S. Boragan Aruoba and Thomas Drechsel},
   title = {Identifying Monetary Policy Shocks: A Natural Language Approach},
   institution = {University of Maryland, NBER, and CEPR},
   type = {Working Paper},
   year = {2024},
   month = {11},
   abstract = {We develop a novel method for the identification of monetary policy shocks. By applying natural language processing techniques to documents that Federal Reserve staff prepare in advance of policy decisions, we capture the Fed's information set. Using machine learning techniques, we then predict changes in the target interest rate conditional on this information set and obtain a measure of monetary policy shocks as the residual.}
}

@article{BallRomer1990,
   author = {Laurence Ball and David Romer},
   title = {Real Rigidities and the Non-Neutrality of Money},
   journal = {Review of Economic Studies},
   year = {1990},
   volume = {57},
   number = {2},
   pages = {183-203},
   doi = {10.2307/2297377},
   abstract = {This paper examines the role of real rigidities in generating substantial non-neutrality of money from small nominal frictions. We show that real rigidities alone do not produce large real effects of nominal shocks, and nominal rigidities alone do not either; but the interaction of real and nominal rigidities can generate large non-neutralities. Real rigidities, which make a firm's desired price depend strongly on other firms' prices, amplify the output effects of a given degree of nominal stickiness.}
}

@article{Baumeister2025,
   author = {Christiane Baumeister},
   title = {Discussion of "Local Projections or VARs? A Primer for Macroeconomists"},
   journal = {NBER Working Paper Series},
   year = {2025},
   abstract = {In this paper, Montiel Olea, Plagborg-Møller, Qian, and Wolf provide a very useful summary of their recent research agenda that compares the benefits of vector autoregressions (VARs) and local projections (LPs) as alternative ways for conducting impulse response analysis, the main tool for quantifying the dynamic causal effects of one-time shocks on macroeconomic outcomes.}
}

@article{BlanchardQuah1989,
   author = {Olivier Jean Blanchard and Danny Quah},
   title = {The Dynamic Effects of Aggregate Demand and Supply Disturbances},
   journal = {American Economic Review},
   year = {1989},
   volume = {79},
   number = {4},
   pages = {655-673},
   abstract = {This paper interprets fluctuations in GNP and unemployment as due to two types of disturbances, those that have a permanent effect on output and those that do not, and identifies them by imposing the restriction that demand disturbances have no long-run effect on the level of output.}
}

@article{BoivinGiannoni2006,
   author = {Jean Boivin and Marc Giannoni},
   title = {Has Monetary Policy Become More Effective?},
   journal = {Review of Economics and Statistics},
   year = {2006},
   volume = {88},
   number = {3},
   pages = {445-462},
   doi = {10.1162/rest.88.3.445},
   abstract = {This paper documents that the volatility of output and inflation in response to monetary policy shocks has declined substantially since the early 1980s, and asks whether this reflects a more effective monetary policy or smaller economic disturbances. Estimating a structural model over the pre- and post-1980 periods, the authors find that the change in the estimated policy rule, rather than a reduction in the variance of exogenous shocks, accounts for most of the increased effectiveness of monetary policy.}
}

@article{Belkin_Hsu_Ma_Mandal2019_Bias_Variance_tradeoff,
   author = {Mikhail Belkin and Daniel Hsu and Siyuan Ma and Soumik Mandal},
   title = {Reconciling Modern Machine-Learning Practice and the Classical Bias--Variance Trade-Off},
   journal = {Proceedings of the National Academy of Sciences},
   year = {2019},
   volume = {116},
   number = {32},
   pages = {15849-15854},
   doi = {10.1073/pnas.1903070116},
   abstract = {Breakthroughs in machine learning are rapidly changing science and society, yet our fundamental understanding of this technology has lagged behind. This paper reconciles the classical U-shaped bias-variance trade-off with the empirically observed behavior of sufficiently rich models, such as neural networks, showing a "double descent" curve that unifies the classical regime and the modern interpolating regime.}
}

@article{Canova1994,
   author = {Fabio Canova},
   title = {Statistical Inference in Calibrated Models},
   journal = {Journal of Applied Econometrics},
   year = {1994},
   volume = {9},
   pages = {S123-S144},
   abstract = {This paper discusses statistical methods for evaluating calibrated dynamic general equilibrium models, proposing simulation-based procedures to assess whether a model's second moments are statistically close to those found in the data.}
}

@book{Canova2007,
   author = {Fabio Canova},
   title = {Methods for Applied Macroeconomic Research},
   publisher = {Princeton University Press},
   address = {Princeton, NJ},
   year = {2007},
   abstract = {A textbook covering methods for estimating, evaluating, and using dynamic general equilibrium models in applied macroeconomic research, including calibration, Bayesian and classical estimation, and comparison of DSGE models with VARs.}
}

@techreport{Carriero_Huber_Pettenuzzo2026,
   author = {Andrea Carriero and Florian Huber and Davide Pettenuzzo},
   title = {Double Descent and Benign Overfitting in Macroeconomic Forecasting},
   institution = {Queen Mary University of London, University of Salzburg, and Brandeis University},
   type = {Working Paper},
   number = {arXiv:2605.15358},
   year = {2026},
   month = {5},
   abstract = {The paper documents double descent and benign overfitting in macroeconomic forecasting, showing that characteristic risk curves arise in standard macroeconomic datasets driven by latent factors, and proposing a factor kernel estimator that outperforms the Stock-Watson factor model benchmark on FRED-MD and FRED-QD.}
}

@techreport{Canova_Fosso2025,
   author = {Fabio Canova and Luca Fosso},
   title = {Low Frequency Movements and SVAR Analyses},
   institution = {Centre for Applied Macroeconomics and Commodity Prices (CAMP)},
   type = {CAMP Working Paper},
   number = {10/2025},
   year = {2025},
   month = {12},
   abstract = {This paper studies the consequences of using a deterministic steady state in Vector Autoregressive (VAR) models when the data may display structural breaks, transitional dynamics, or low-frequency fluctuations. We document substantial upward biases in the estimated coefficients, with distortions further amplified by the identification scheme. Allowing the steady state to be stochastic mitigates the problem.}
}

@article{Calvo1983,
   author = {Guillermo A. Calvo},
   title = {Staggered Prices in a Utility-Maximizing Framework},
   journal = {Journal of Monetary Economics},
   year = {1983},
   volume = {12},
   number = {3},
   pages = {383-398},
   doi = {10.1016/0304-3932(83)90060-0},
   abstract = {This paper develops a model of staggered price setting in which firms that are able to reoptimise do so only with a fixed probability each period, giving rise to a simple and tractable framework for studying nominal price rigidity and its consequences for monetary policy.}
}

@article{Chang_Hong2006,
   author = {Yongsung Chang and Jay H. Hong},
   title = {Do Technological Improvements in the Manufacturing Sector Raise or Lower Employment?},
   journal = {American Economic Review},
   year = {2006},
   volume = {96},
   number = {1},
   pages = {352-368},
   doi = {10.1257/000282806776157687},
   abstract = {Using sector-level data on technology and hours worked, this paper finds that a positive technology shock raises employment in the manufacturing sector, contrary to the negative response typically found for aggregate hours in structural VAR studies, and argues that the aggregate result partly reflects the reallocation of hours across sectors.}
}

@article{ChariKehoeMcGrattan2008,
   author = {V. V. Chari and Patrick J. Kehoe and Ellen R. McGrattan},
   title = {Are Structural VARs with Long-Run Restrictions Useful in Developing Business Cycle Theory?},
   journal = {Journal of Monetary Economics},
   year = {2008},
   volume = {55},
   number = {8},
   pages = {1337-1352},
   doi = {10.1016/j.jmoneco.2008.09.010},
   abstract = {We use a real business cycle model to evaluate the ability of structural vector autoregressions (SVARs) to answer the empirical question of whether technology shocks lead to a rise or a fall in labor input. We find that SVARs with the long-run restrictions commonly used in the literature are, in general, poor devices for recovering the effects of technology shocks on hours worked.}
}

@article{CEE2005,
   author = {Lawrence J. Christiano and Martin Eichenbaum and Charles L. Evans},
   title = {Nominal Rigidities and the Dynamic Effects of a Shock to Monetary Policy},
   journal = {Journal of Political Economy},
   year = {2005},
   volume = {113},
   number = {1},
   pages = {1-45},
   doi = {10.1086/426038},
   abstract = {We present a model embodying moderate amounts of nominal rigidities that accounts for the observed inertia in inflation and persistence in output. The key features of our model are those that prevent a sharp rise in marginal costs after an expansionary shock to monetary policy. Of these features, the most important are staggered wage contracts that have an average duration of three quarters and variable capital utilization.}
}

@techreport{DeGraeve_Westermark2013,
   author = {De Graeve, Ferre and Westermark, Andreas},
   title = {Un-Truncating VARs},
   institution = {Sveriges Riksbank},
   type = {Sveriges Riksbank Working Paper Series},
   number = {271},
   year = {2013},
   abstract = {This paper studies the consequences of the standard practice of truncating structural vector autoregressions (VARs) at a low lag order, and proposes and implements a way to "un-truncate" VARs so as to reduce the resulting misspecification bias.}
}

@article{Long_Lag2025,
   author = {De Graeve, Ferre and Westermark, Andreas},
   title = {Long-Lag VARs},
   journal = {Journal of Monetary Economics},
   year = {2025},
   volume = {156},
   doi = {10.1016/j.jmoneco.2025.103831},
   abstract = {Macroeconomic research often relies on structural vector autoregressions, (S)VARs, to uncover empirical regularities. Critics argue the method goes awry due to lag truncation: short lag lengths imply a poor approximation to important data-generating processes (e.g. DSGE models). Empirically, short lag length is deemed necessary as increased parametrization induces excessive uncertainty. The paper shows that this argument is incomplete. Longer lag length simultaneously reduces misspecification, which in turn reduces variance.}
}

@article{FVRRSS2007,
   author = {Jesús Fernández-Villaverde and Juan F. Rubio-Ramírez and Thomas J. Sargent and Mark W. Watson},
   title = {ABCs (and Ds) of understanding VARs},
   journal = {American Economic Review},
   volume = {97},
   number = {3},
   pages = {1021--1026},
   year = {2007},
   month = {6},
   publisher = {American Economic Association},
   abstract = {The dynamics of a linear (or linearized) dynamic stochastic economic model can be expressed in terms of matrices (A, B, C, D) that define a state space system for a vector of observables. An associated state space system (A, ^ B,C, ^D) determines a vector autoregression for those same observables. We present a simple condition for checking when these two state space systems match up and when they do not when there are equal numbers of economic and VAR shocks. We illustrate our condition with a permanent income example. (JEL C32, E32)}
}

@book{Lutkepohl1993,
   author = {Helmut Lütkepohl},
   title = {Introduction to Multiple Time Series Analysis},
   publisher = {Springer-Verlag},
   address = {Berlin},
   edition = {2nd},
   year = {1993}
}

@techreport{ChariKehoeMcGrattan2005,
   author = {V. V. Chari and Patrick J. Kehoe and Ellen R. McGrattan},
   title = {A Critique of Structural VARs Using Real Business Cycle Theory},
   institution = {Federal Reserve Bank of Minneapolis},
   type = {Working Paper},
   number = {631},
   year = {2005},
   abstract = {We evaluate the differenced-specification structural VAR (DSVAR) approach used to argue that technology shocks lead to a fall in hours worked, by asking whether the approach correctly recovers the true impulse responses when applied to data generated by a business cycle model in which technology shocks raise hours. We find the DSVAR approach is misspecified to a degree that produces quantitatively large, mistaken inferences.}
}

@article{CEV2007,
   author = {Lawrence J. Christiano and Martin Eichenbaum and Robert Vigfusson},
   title = {Assessing Structural VARs},
   journal = {NBER Macroeconomics Annual},
   year = {2007},
   volume = {21},
   pages = {1-72},
   abstract = {We analyze the quality of VAR-based procedures for estimating the response of the economy to a shock, assessing whether VAR-based confidence intervals accurately reflect the actual degree of sampling uncertainty associated with impulse response estimates, and the size of the bias in VAR-based impulse responses relative to those confidence intervals.}
}

@article{SW2007,
   author = {Frank Smets and Rafael Wouters},
   title = {Shocks and Frictions in {US} Business Cycles: A {B}ayesian {DSGE} Approach},
   journal = {American Economic Review},
   year = {2007},
   volume = {97},
   number = {3},
   pages = {586-606},
   doi = {10.1257/aer.97.3.586},
   abstract = {We estimate a dynamic stochastic general equilibrium model with sticky prices and wages, and habit formation, for the US economy using seven macroeconomic time series in a Bayesian framework. The model incorporates several real and nominal frictions and seven orthogonal structural shocks, allowing it to capture the covariance dynamics of output, consumption, investment, hours, wages, inflation and the interest rate. We compare its forecasting performance to standard and Bayesian VARs, and use it to identify the relative importance of different shocks for business cycle fluctuations.}
}

@techreport{FernandezVillaverde2026,
   author = {Jesús Fernández-Villaverde},
   title = {Deep Learning for Solving Economic Models},
   institution = {University of Pennsylvania},
   type = {Working Paper},
   year = {2026},
   abstract = {The ongoing revolution in deep learning is reshaping research across many fields, including economics. This paper surveys how deep learning offers flexible tools that solve dynamic economic models by minimizing residuals in equilibrium conditions, avoiding the curse of dimensionality that limits traditional numerical methods such as value function iteration, perturbation, and projection techniques.}
}

@article{Fisher2006,
   author = {Jonas D. M. Fisher},
   title = {The Dynamic Effects of Neutral and Investment-Specific Technology Shocks},
   journal = {Journal of Political Economy},
   year = {2006},
   volume = {114},
   number = {3},
   pages = {413-451},
   doi = {10.1086/505048},
   abstract = {This paper identifies neutral and investment-specific technology shocks in a structural VAR and studies their role in postwar U.S. business cycles, finding that together they account for the majority of output variation at business cycle frequencies, with investment-specific shocks playing the larger role.}
}

@techreport{Forni_Gambetti_Sala2016,
   author = {Mario Forni and Luca Gambetti and Luca Sala},
   title = {VAR Information and the Empirical Validation of DSGE Models},
   institution = {RECent - Center for Economic Research, University of Modena and Reggio Emilia},
   type = {RECent Working Paper},
   number = {119},
   year = {2016},
   month = {4},
   abstract = {We propose a method to validate a DSGE model using the information contained in a structural VAR, distinguishing between the case in which the VAR is fundamental for the DSGE shocks and the case in which it is not, and applying the procedure to a standard New Keynesian model.}
}

@article{Gali1999,
   author = {Jordi Gal{\'i}},
   title = {Technology, Employment, and the Business Cycle: Do Technology Shocks Explain Aggregate Fluctuations?},
   journal = {American Economic Review},
   year = {1999},
   volume = {89},
   number = {1},
   pages = {249-271},
   doi = {10.1257/aer.89.1.249},
   abstract = {Using a structural VAR with a long-run restriction to identify technology shocks, this paper finds that hours worked fall significantly following a positive technology shock, a result at odds with standard real business cycle models but consistent with sticky-price models in which firms meet unexpected demand out of inventories or by varying labour effort rather than hours.}
}

@techreport{Giacomini2013,
   author = {Raffaella Giacomini},
   title = {The Relationship Between DSGE and VAR Models},
   institution = {Centre for Microdata Methods and Practice (cemmap)},
   type = {cemmap Working Paper},
   number = {CWP21/13},
   year = {2013},
   doi = {10.1920/wp.cem.2013.2113},
   abstract = {This paper reviews the relationship between dynamic stochastic general equilibrium (DSGE) models and vector autoregressions (VARs), covering the conditions under which a DSGE model admits a finite-order VAR representation, and the implications for structural VAR analysis and DSGE model evaluation.}
}

@techreport{GonzalezCasasus_Schorfheide2025,
   author = {Oriol González-Casasús and Frank Schorfheide},
   title = {Misspecification-Robust Shrinkage and Selection for VAR Forecasts and IRFs},
   institution = {National Bureau of Economic Research},
   type = {NBER Working Paper},
   number = {33474},
   year = {2025},
   month = {2},
   abstract = {We develop shrinkage and model-selection procedures for vector autoregressions (VARs) that remain valid under model misspecification, and study their implications for the accuracy of VAR forecasts and estimated impulse response functions (IRFs).}
}

@article{Hall_Inoue_Nason_Rossi2012,
   author = {Barbara Rossi and Alastair R. Hall and Atsushi Inoue and James M. Nason},
   title = {Information Criteria for Impulse Response Function Matching Estimation of DSGE Models},
   journal = {Journal of Econometrics},
   year = {2012},
   volume = {170},
   number = {2},
   pages = {499-518},
   doi = {10.1016/j.jeconom.2012.05.019},
   abstract = {This paper proposes information criteria to select the impulse responses to be matched, the number of lags in the vector autoregression from which the impulse responses are estimated, and the number of shocks that impinge on the model economy, within the impulse response matching approach to estimating DSGE models.}
}

@techreport{Humble_VARs_2026,
   author = {Régis Barnichon and Geert Mesters and Emi Nakamura and Jón Steinsson},
   title = {Humble VARs},
   institution = {University of California, Berkeley},
   type = {Working Paper},
   year = {2026},
   month = {7},
   abstract = {Macroeconomic VARs are often interpreted as models of the entire economy, yet in practice they are typically small systems with few variables and lags. As a result, estimated impulse responses are often highly sensitive to lag length and variable selection. We argue that VARs for impulse response analysis should therefore be viewed more modestly: rather than representing the whole economy, they should only be expected to approximately capture the transmission of the shock of interest. We propose Conditional Cross-Validation (CCV), a criterion for choosing VARs optimized for impulse response estimation. Different VARs can be selected based on the outcome variable, horizon (short- vs. long-run), or the researcher's loss function.}
}

@article{Jarocinski_Karadi2020,
   author = {Marek Jarociński and Peter Karadi},
   title = {Deconstructing Monetary Policy Surprises: The Role of Information Shocks},
   journal = {American Economic Journal: Macroeconomics},
   year = {2020},
   volume = {12},
   number = {2},
   pages = {1-43},
   doi = {10.1257/mac.20180090},
   abstract = {We disentangle monetary policy shocks from information shocks by exploiting their different effects on interest rates and stock prices. A central bank's announcement that raises interest rates and stock prices conveys positive information about the economy. An announcement that raises interest rates but depresses stock prices is a pure monetary policy shock. We find that these two shocks have highly significantly different effects on the economy.}
}

@article{Jorda2005,
   author = {Jord{\`a}, {\`O}scar},
   title = {Estimation and Inference of Impulse Responses by Local Projections},
   journal = {American Economic Review},
   year = {2005},
   volume = {95},
   number = {1},
   pages = {161-182},
   doi = {10.1257/0002828053828518},
   abstract = {This paper introduces methods to compute impulse responses without specification and estimation of the underlying multivariate dynamic system. The central idea consists in estimating local projections at each period of interest rather than extrapolating into increasingly distant horizons from a given model, as it is done with vector autoregressions (VAR). The advantages of local projections are numerous...}
}

@article{Jorda2024long_run_mp,
   author = {Oscar Jordà and Sanjay R. Singh and Alan M. Taylor},
   title = {The Long-Run Effects of Monetary Policy},
   journal = {The Review of Economics and Statistics},
   year = {2024},
   doi = {10.1162/rest_a_01527},
   abstract = {We document that the real effects of monetary shocks last for over a decade. Our approach relies on (1) identification of exogenous and non-systematic monetary shocks using the trilemma of international finance; (2) merged data from two new international historical crosscountry databases; and (3) econometric methods robust to long-horizon inconsistent estimates. Notably, the capital stock and total factor productivity (TFP) exhibit greater hysteresis than labor.}
}

@unpublished{Jorda2025Comment,
   author = {Jord{\`a}, {\`O}scar},
   title = {Comment: Local Projections or VARs? A Primer for Macroeconomists},
   note = {Discussion of Montiel Olea, Plagborg-Møller, Qian, and Wolf (2025), prepared for the NBER Macroeconomics Annual},
   year = {2025},
   month = {5},
   abstract = {A discussion of Montiel Olea, Plagborg-Møller, Qian, and Wolf's primer on local projections versus VARs, focusing on: the two contrasting ways to think about impulse responses; whether cumulative response ratios should be reported instead of impulse responses; the implications of lag-length choice in a VAR versus an LP; and the variance-bias trade-off between the two approaches.}
}

@techreport{Li_PlagborgMoller_Wolf2024,
   author = {Dake Li and Mikkel Plagborg-Møller and Christian K. Wolf},
   title = {Local Projections vs. VARs: Lessons From Thousands of DGPs},
   institution = {Two Sigma Investments, Princeton University, and MIT},
   type = {Working Paper},
   year = {2024},
   month = {1},
   abstract = {We conduct a simulation study of Local Projection (LP) and Vector Autoregression (VAR) estimators of structural impulse responses across thousands of data generating processes, designed to mimic the properties of the universe of U.S. macroeconomic data. A clear bias-variance trade-off emerges: LP estimators have lower bias than VAR estimators, but VAR estimators have lower variance.}
}

@article{Lippi_Reichlin1993,
   author = {Marco Lippi and Lucrezia Reichlin},
   title = {The Dynamic Effects of Aggregate Demand and Supply Disturbances: Comment},
   journal = {American Economic Review},
   year = {1993},
   volume = {83},
   number = {3},
   pages = {644-652},
   doi = {10.2307/2117539},
   abstract = {This comment on \citet{BlanchardQuah1989} points out that their long-run identification rests on an arbitrary assumption about the moving-average representation, namely that none of the zeros of the determinant of the moving-average polynomial lies inside the unit circle. The authors show that a simple and natural modification of the underlying macroeconomic model can produce a moving-average representation with zeros on the other side of the unit circle, and that exploring such nonfundamental representations on Blanchard and Quah's own data yields economically sensible alternative impulse responses in which demand shocks play a considerably smaller role.}
}

@article{Ludwig2026,
   author = {Julian F. Ludwig},
   title = {Local Projections Are VAR Predictions of Increasing Order},
   journal = {Working Paper, R\&R Econometrica 2nd Round },
   year = {2026},
   abstract = {This paper explores local projections (LPs) and vector autoregressions (VARs), two important time series models in economics. I prove that LPs can be represented as combinations of equal and higher-order VARs, while VARs themselves are combinations of equal and lower-order LPs. This finding advances our understanding of LPs and VARs and leads to enhanced efficiency and model selection.}
}


@techreport{Montiel-Olea_Plagborg-Moller_Qian_Wolf2025,
   author = {José Luis Montiel-Olea and Mikkel Plagborg-Møller and Eric Qian and Christian K. Wolf},
   title = {Local Projections or VARs? A Primer for Macroeconomists},
   institution = {National Bureau of Economic Research},
   type = {NBER Working Paper},
   number = {33871},
   year = {2025},
   month = {5},
   abstract = {We provide a practical guide to the choice between local projections (LPs) and vector autoregressions (VARs) for the estimation of impulse responses in macroeconomics, summarizing the theoretical equivalence results, the finite-sample bias-variance trade-off, and practical recommendations for applied researchers.}
}

@article{MirandaAgrippinoRicco2021,
   author = {Silvia Miranda-Agrippino and Giovanni Ricco},
   title = {The transmission of monetary policy shocks},
   journal = {American Economic Journal: Macroeconomics},
   volume = {13},
   number = {3},
   pages = {74--107},
   year = {2021},
   month = {7},
   publisher = {American Economic Association},
   abstract = {Commonly used instruments for the identification of monetary policy disturbances are likely to combine the true policy shock with information about the state of the economy due to the information disclosed through the policy action. We show that this signaling effect of monetary policy can give rise to the empirical puzzles reported in the literature, and propose a new high-frequency instrument for monetary policy shocks that accounts for informational rigidities. We find that a monetary tightening is unequivocally contractionary, with deterioration of domestic demand, labor and credit market conditions as well as of asset prices and agents’ expectations. (JEL D82, D84, E32, E43, E52, E58, G12)}
}

@article{Plagborg-Moller_Wolf2021,
   author = {Mikkel Plagborg-Møller and Christian K. Wolf},
   title = {Local Projections and VARs Estimate the Same Impulse Responses},
   journal = {Econometrica},
   year = {2021},
   volume = {89},
   number = {2},
   pages = {955-980},
   doi = {10.3982/ECTA17810},
   abstract = {We show that linear local projections and vector autoregressions (VARs) estimate the same impulse responses. This equivalence holds exactly for the sample estimators, provided that the lag length in the local projection and the VAR are the same, and the local projection is estimated efficiently. We discuss implications for applied work.}
}

@incollection{Ramey2016,
  title={Macroeconomic shocks and their propagation},
  author={Ramey, Valerie A.},
  booktitle={Handbook of Macroeconomics},
  volume={2},
  pages={71--162},
  year={2016},
  publisher={Elsevier}
}

@article{Faust_Leeper1997,
   author = {Jon Faust and Eric M. Leeper},
   title = {When Do Long-Run Identifying Restrictions Give Reliable Results?},
   journal = {Journal of Business \& Economic Statistics},
   year = {1997},
   volume = {15},
   number = {3},
   pages = {345-353},
   doi = {10.1080/07350015.1997.10524712},
   abstract = {This paper examines the reliability of long-run restrictions used to identify structural shocks in VARs, showing that such restrictions can be poorly estimated in finite samples and that the resulting impulse response estimates can be highly imprecise, even when the identifying restrictions are correctly specified.}
}

@article{Erceg_Guerrieri_Gust2005,
   author = {Christopher J. Erceg and Luca Guerrieri and Christopher Gust},
   title = {Can Long-Run Restrictions Identify Technology Shocks?},
   journal = {Journal of the European Economic Association},
   year = {2005},
   volume = {3},
   number = {6},
   pages = {1237-1278},
   doi = {10.1162/154247605775012860},
   abstract = {Using a estimated DSGE model as a laboratory, this paper evaluates the ability of structural VARs with long-run restrictions to recover the true response of hours worked to a technology shock, finding that estimated impulse responses can be severely biased in small samples even when the identifying restriction is correctly specified in population.}
}

@article{Ravenna2007,
   author = {Federico Ravenna},
   title = {Vector Autoregressions and Reduced Form Representations of DSGE Models},
   journal = {Journal of Monetary Economics},
   year = {2007},
   volume = {54},
   number = {7},
   pages = {2048-2064},
   doi = {10.1016/j.jmoneco.2006.09.002},
   abstract = {This paper studies the conditions under which a DSGE model admits a finite-order VAR representation of its equilibrium law of motion, and the consequences for the use of structural VARs to estimate the effects of shocks and to evaluate DSGE models.}
}

@incollection{RotembergWoodford1997,
   author = {Julio J. Rotemberg and Michael Woodford},
   title = {An Optimization-Based Econometric Framework for the Evaluation of Monetary Policy},
   booktitle = {NBER Macroeconomics Annual 1997},
   editor = {Ben S. Bernanke and Julio J. Rotemberg},
   publisher = {MIT Press},
   year = {1997},
   volume = {12},
   pages = {297-346},
   abstract = {This paper develops a small structural econometric model, derived from the optimizing behaviour of households and firms, for use in the quantitative evaluation of monetary policy rules. Grounding the structural relations in individual optimization allows the analysis to respond to the Lucas critique and to derive a utility-based welfare criterion for comparing alternative policies.}
}

@incollection{Shapiro_Watson88,
   author = {Matthew D. Shapiro and Mark W. Watson},
   title = {Sources of Business Cycle Fluctuations},
   booktitle = {NBER Macroeconomics Annual 1988},
   editor = {Stanley Fischer},
   publisher = {MIT Press},
   year = {1988},
   volume = {3},
   pages = {111-148},
   doi = {10.1086/654078},
   abstract = {This paper measures the relative importance of aggregate demand and supply disturbances for postwar US business cycle fluctuations, identifying the shocks through long-run restrictions imposed on a vector autoregression and estimated by instrumental variables.}
}

@article{Sims_Zha1999,
   author = {Christopher A. Sims and Tao Zha},
   title = {Error Bands for Impulse Responses},
   journal = {Econometrica},
   year = {1999},
   volume = {67},
   number = {5},
   pages = {1113-1156},
   doi = {10.1111/1468-0262.00071},
   abstract = {This paper proposes likelihood-based methods for constructing error bands for impulse response functions estimated from vector autoregressions, comparing Bayesian and bootstrap approaches and showing that commonly used asymptotic bands can be misleading, particularly for persistent variables.}
}

@article{Uhlig2005,
   author = {Harald Uhlig},
   title = {What Are the Effects of Monetary Policy on Output? Results from an Agnostic Identification Procedure},
   journal = {Journal of Monetary Economics},
   year = {2005},
   volume = {52},
   number = {2},
   pages = {381-419},
   doi = {10.1016/j.jmoneco.2004.05.007},
   abstract = {This paper identifies monetary policy shocks in a VAR by imposing sign restrictions on the responses of prices and non-borrowed reserves, without restricting the sign of the response of output, finding that contractionary monetary policy shocks have at best a very limited effect on output.}
}

@article{Iacoviello2005,
   author = {Matteo Iacoviello},
   title = {House Prices, Borrowing Constraints, and Monetary Policy in the Business Cycle},
   journal = {American Economic Review},
   year = {2005},
   volume = {95},
   number = {3},
   pages = {739-764},
   doi = {10.1257/0002828054201477},
   abstract = {This paper develops and estimates a monetary business cycle model with nominal loans and collateral constraints tied to housing values. Demand shocks move housing and nominal prices in the same direction, and are amplified and propagated over time. The financial accelerator is not uniform: nominal debt dampens supply shocks, stabilizing the economy under interest rate control. Structural estimation supports two key model features: collateral effects dramatically improve the response of aggregate demand to housing price shocks, and nominal debt improves the sluggish response of output to inflation surprises.}
}

@techreport{Theodoridis2011,
   author = {Konstantinos Theodoridis},
   title = {An Efficient Minimum Distance Estimator for DSGE Models},
   institution = {Bank of England},
   type = {Bank of England Working Paper},
   number = {439},
   year = {2011},
   month = {10},
   abstract = {Recent studies illustrate that under some conditions dynamic stochastic general equilibrium models can be expressed as structural vector autoregressive models of infinite order. Based on this mapping, this paper proposes a minimum distance estimator that matches the k-period responses of the observable variables implied by the structural model with those recovered from a VAR estimated on the historical data, and shows that this estimator is asymptotically efficient.}
}
@article{BilsKlenow2004,
    author  = {Bils, Mark and Klenow, Peter J.},
    title   = {Some Evidence on the Importance of Sticky Prices},
    journal = {Journal of Political Economy},
    year    = {2004},
    volume  = {112},
    number  = {5},
    pages   = {947--985},
    doi     = {10.1086/422559},
    abstract = {Using data on prices for 350 categories of goods and services covering about 70 percent of consumer spending, this paper estimates that prices change on average every 4.3 months, considerably more frequently than assumed in most sticky-price macroeconomic models, and that price flexibility varies systematically across categories.}
}

@article{GolosovLucas2007,
    author  = {Golosov, Mikhail and Lucas, Robert E., Jr.},
    title   = {Menu Costs and {P}hillips Curves},
    journal = {Journal of Political Economy},
    year    = {2007},
    volume  = {115},
    number  = {2},
    pages   = {171--199},
    doi     = {10.1086/512625},
    abstract = {This paper develops a menu-cost model of price setting calibrated to reproduce the size and frequency of individual price changes observed in the data, and finds that the resulting aggregate output effects of a monetary shock are much smaller and less persistent than those implied by time-dependent (Calvo-style) pricing models.}
}

@article{KlenowKryvtsov2008,
    author  = {Klenow, Peter J. and Kryvtsov, Oleksiy},
    title   = {State-Dependent or Time-Dependent Pricing: Does It Matter for Recent {U.S.} Inflation?},
    journal = {Quarterly Journal of Economics},
    year    = {2008},
    volume  = {123},
    number  = {3},
    pages   = {863--904},
    doi     = {10.1162/qjec.2008.123.3.863},
    abstract = {Using the same micro price data underlying the CPI, this paper asks whether the frequency and size of individual price changes, rather than the average markup, drive fluctuations in inflation, concluding that most of the variance in inflation is explained by how much prices change rather than how often they change.}
}
