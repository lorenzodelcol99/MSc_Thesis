@techreport{ACEL2005WP,
   author = {David Altig and Lawrence J. Christiano and Martin Eichenbaum and Jesper Lindé},
   title = {Firm-Specific Capital, Nominal Rigidities and the Business Cycle},
   institution = {National Bureau of Economic Research},
   type = {NBER Working Paper},
   number = {11034},
   year = {2005},
   month = {1},
   note = {Working paper predecessor of the published version (Review of Economic Dynamics, 2011)},
   abstract = {This paper formulates and estimates a three-shock U.S. business cycle model. The estimated model accounts for a substantial fraction of the cyclical variation in output and is consistent with the observed inertia in inflation. This is true even though firms in the model re-optimize prices on average once every 1.8 quarters. The key feature of our model underlying this result is that capital is firm-specific.}
}

@article{ACEL2011,
   author = {David Altig and Lawrence J. Christiano and Martin Eichenbaum and Jesper Lindé},
   title = {Firm-Specific Capital, Nominal Rigidities and the Business Cycle},
   journal = {Review of Economic Dynamics},
   year = {2011},
   volume = {14},
   number = {2},
   pages = {225-247},
   doi = {10.1016/j.red.2010.01.001},
   abstract = {This paper formulates and estimates a three-shock U.S. business cycle model. The estimated model accounts for a substantial fraction of the cyclical variation in output and is consistent with the observed inertia in inflation. This is true even though firms in the model re-optimize prices on average once every 1.8 quarters. The key feature of our model underlying this result is that capital is firm-specific.}
}

@article{Antolin-Diaz_Surico2025,
   author = {Juan Antolín-Díaz and Paolo Surico},
   title = {The Long-Run Effects of Government Spending},
   journal = {American Economic Review},
   year = {2025},
   volume = {115},
   number = {7},
   pages = {2376-2413},
   doi = {10.1257/aer.20231278},
   abstract = {Military spending has large and persistent effects on output because it shifts the composition of public spending toward R\&D. This boosts innovation and private investment in the medium term and increases productivity and GDP at longer horizons. Public R\&D expenditure stimulates economic activities beyond the business cycle even when it is not associated with war spending.}
}

@techreport{AntolinDiaz_FernandezVillaverde_GuerronQuintana2026,
   author = {Juan Antolín-Díaz and Jesús Fernández-Villaverde and Pablo Guerrón-Quintana},
   title = {Double Descent in Time Series},
   institution = {MIT, University of Pennsylvania, and Boston College},
   type = {Working Paper},
   year = {2026},
   month = {6},
   abstract = {The paper studies whether the "double descent" phenomenon documented in the machine learning literature -- a second decline in test error as model complexity grows well beyond the sample size, beyond the classical U-shaped bias-variance trade-off -- also arises in time series settings relevant to macroeconometrics, including in the solution of DSGE models.}
}

@techreport{Aruoba_Drechsel2024_MP_LLM,
   author = {S. Boragan Aruoba and Thomas Drechsel},
   title = {Identifying Monetary Policy Shocks: A Natural Language Approach},
   institution = {University of Maryland, NBER, and CEPR},
   type = {Working Paper},
   year = {2024},
   month = {11},
   abstract = {We develop a novel method for the identification of monetary policy shocks. By applying natural language processing techniques to documents that Federal Reserve staff prepare in advance of policy decisions, we capture the Fed's information set. Using machine learning techniques, we then predict changes in the target interest rate conditional on this information set and obtain a measure of monetary policy shocks as the residual.}
}

@article{Baumeister2025,
   author = {Christiane Baumeister},
   title = {Discussion of "Local Projections or VARs? A Primer for Macroeconomists"},
   journal = {NBER Working Paper Series},
   year = {2025},
   abstract = {In this paper, Montiel Olea, Plagborg-Møller, Qian, and Wolf provide a very useful summary of their recent research agenda that compares the benefits of vector autoregressions (VARs) and local projections (LPs) as alternative ways for conducting impulse response analysis, the main tool for quantifying the dynamic causal effects of one-time shocks on macroeconomic outcomes.}
}

@article{Belkin_Hsu_Ma_Mandal2019_Bias_Variance_tradeoff,
   author = {Mikhail Belkin and Daniel Hsu and Siyuan Ma and Soumik Mandal},
   title = {Reconciling Modern Machine-Learning Practice and the Classical Bias--Variance Trade-Off},
   journal = {Proceedings of the National Academy of Sciences},
   year = {2019},
   volume = {116},
   number = {32},
   pages = {15849-15854},
   doi = {10.1073/pnas.1903070116},
   abstract = {Breakthroughs in machine learning are rapidly changing science and society, yet our fundamental understanding of this technology has lagged behind. This paper reconciles the classical U-shaped bias-variance trade-off with the empirically observed behavior of sufficiently rich models, such as neural networks, showing a "double descent" curve that unifies the classical regime and the modern interpolating regime.}
}

@techreport{Canova_Fosso2025,
   author = {Fabio Canova and Luca Fosso},
   title = {Low Frequency Movements and SVAR Analyses},
   institution = {Centre for Applied Macroeconomics and Commodity Prices (CAMP)},
   type = {CAMP Working Paper},
   number = {10/2025},
   year = {2025},
   month = {12},
   abstract = {This paper studies the consequences of using a deterministic steady state in Vector Autoregressive (VAR) models when the data may display structural breaks, transitional dynamics, or low-frequency fluctuations. We document substantial upward biases in the estimated coefficients, with distortions further amplified by the identification scheme. Allowing the steady state to be stochastic mitigates the problem.}
}

@article{ChariKehoeMcGrattan2008,
   author = {V. V. Chari and Patrick J. Kehoe and Ellen R. McGrattan},
   title = {Are Structural VARs with Long-Run Restrictions Useful in Developing Business Cycle Theory?},
   journal = {Journal of Monetary Economics},
   year = {2008},
   volume = {55},
   number = {8},
   pages = {1337-1352},
   doi = {10.1016/j.jmoneco.2008.09.010},
   abstract = {We use a real business cycle model to evaluate the ability of structural vector autoregressions (SVARs) to answer the empirical question of whether technology shocks lead to a rise or a fall in labor input. We find that SVARs with the long-run restrictions commonly used in the literature are, in general, poor devices for recovering the effects of technology shocks on hours worked.}
}

@article{CEE2005,
   author = {Lawrence J. Christiano and Martin Eichenbaum and Charles L. Evans},
   title = {Nominal Rigidities and the Dynamic Effects of a Shock to Monetary Policy},
   journal = {Journal of Political Economy},
   year = {2005},
   volume = {113},
   number = {1},
   pages = {1-45},
   doi = {10.1086/426038},
   abstract = {We present a model embodying moderate amounts of nominal rigidities that accounts for the observed inertia in inflation and persistence in output. The key features of our model are those that prevent a sharp rise in marginal costs after an expansionary shock to monetary policy. Of these features, the most important are staggered wage contracts that have an average duration of three quarters and variable capital utilization.}
}

@techreport{DeGraeve_Westermark2013,
   author = {Ferre De Graeve and Andreas Westermark},
   title = {Un-Truncating VARs},
   institution = {Sveriges Riksbank},
   type = {Sveriges Riksbank Working Paper Series},
   number = {271},
   year = {2013},
   abstract = {This paper studies the consequences of the standard practice of truncating structural vector autoregressions (VARs) at a low lag order, and proposes and implements a way to "un-truncate" VARs so as to reduce the resulting misspecification bias.}
}

@article{Long_Lag2025,
   author = {De Graeve, Ferre and Westermark, Andreas},
   title = {Long-Lag VARs},
   journal = {Journal of Monetary Economics},
   year = {2025},
   volume = {156},
   doi = {10.1016/j.jmoneco.2025.103831},
   abstract = {Macroeconomic research often relies on structural vector autoregressions, (S)VARs, to uncover empirical regularities. Critics argue the method goes awry due to lag truncation: short lag lengths imply a poor approximation to important data-generating processes (e.g. DSGE models). Empirically, short lag length is deemed necessary as increased parametrization induces excessive uncertainty. The paper shows that this argument is incomplete. Longer lag length simultaneously reduces misspecification, which in turn reduces variance.}
}

@techreport{FVRRS2005,
   author = {Jesús Fernández-Villaverde and Juan Rubio-Ramírez and Thomas J. Sargent},
   title = {A, B, C's (and D)'s for Understanding VARs},
   institution = {National Bureau of Economic Research},
   type = {NBER Technical Working Paper},
   number = {308},
   year = {2005},
   month = {5},
   abstract = {This paper studies the connection between two popular representations of a dynamic economic model: the state-space (or ABCD) representation used in solving and simulating economic models, and the vector autoregressive (VAR) representation used for empirical analysis. We provide a simple condition for checking when the two representations are equivalent.}
}

